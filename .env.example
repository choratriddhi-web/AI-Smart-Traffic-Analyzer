# AI Smart Traffic Analyzer - Environment Configuration
SECRET_KEY=django-insecure-ai-smart-traffic-analyzer-purple-theme-key-2026-xyz987
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# MongoDB Configuration (PyMongo)
# For local MongoDB: mongodb://127.0.0.1:27017/
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB_NAME=ai_smart_traffic_analyzer
MONGO_TIMEOUT_MS=3000

# AI / YOLO Configuration
YOLO_MODEL_PATH=ai_models/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45
USE_BYTETRACK=True

# Video / Camera Storage
CAMERA_STORAGE_PATH=media/cameras/
PROCESSED_STORAGE_PATH=media/processed/

# Application Defaults
DEFAULT_CAMERA_FPS=15
DENSITY_LOW_THRESHOLD=5
DENSITY_MODERATE_THRESHOLD=12
DENSITY_HIGH_THRESHOLD=22
